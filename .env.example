# .env dosyası — bunu projenin köküne koy, Git'e commit etme!

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://hes_admin:123456@localhost:5432/hes_management

# JWT
SECRET_KEY=123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=HES Auth Service
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
