# .env dosyası template'i — bunu .env olarak kopyala ve değerleri doldur
# Bu dosya GitHub'a yüklenir, şifreler içermez!

# PostgreSQL
POSTGRES_USER=hes_admin
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=hes_management

DATABASE_URL="postgresql+asyncpg://hes_admin:your_password_here@localhost:5432/hes_management"

# JWT
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=HES Auth Service
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
